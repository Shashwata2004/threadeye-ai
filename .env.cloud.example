# ThreadEye AI: cloud_demo profile (Supabase + Vercel). Copy to .env.cloud and fill in.
# NEVER commit .env.cloud. Secrets live only in environment variables.
#
# Supabase dashboard → project → "Connect" button → "Connection string" tab.
# Copy BOTH strings below and replace [YOUR-PASSWORD] with the database password.
# Change the scheme from "postgresql://" to "postgresql+psycopg://" (SQLAlchemy needs the driver).

THREADEYE_DEPLOY_PROFILE=cloud_demo

# 1) RUNTIME: "Transaction pooler" (port 6543). Used by the API on every request.
#    Serverless-safe: short-lived connections, no prepared statements.
THREADEYE_DATABASE_URL=postgresql+psycopg://postgres.<PROJECT-REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:6543/postgres

# 2) MIGRATIONS: "Session pooler" (port 5432). Used only by `threadeye migrate`.
#    The transaction pooler cannot run DDL (CREATE SCHEMA / TRIGGER / FUNCTION) safely.
THREADEYE_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<PROJECT-REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:5432/postgres

# Behind HTTPS on Vercel
THREADEYE_COOKIE_SECURE=true

# The Vercel frontend origin that may call the API (no trailing slash)
THREADEYE_ALLOWED_ORIGINS=https://<your-frontend>.vercel.app

# Demo accounts for the judges. Use a DIFFERENT password from the local one.
THREADEYE_SEED_DEMO_USERS=true
# Rule profiles, one machine, and clearly fictional mills/buyers (flagged SAMPLE DATA).
THREADEYE_SEED_SAMPLE_DATA=true
THREADEYE_DEMO_PASSWORD=<choose-a-strong-demo-password>

THREADEYE_DETECTOR_PROVIDER=simulated
