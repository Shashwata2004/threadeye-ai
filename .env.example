# ThreadEye AI: environment variables.
# Copy to .env (`make env`) and change the values. Never commit .env.
# All secrets live in environment variables only (PLAN.md §5, security baseline).

# --- Deployment profile: edge (Docker Compose, offline) | cloud_demo (Vercel + Supabase)
THREADEYE_DEPLOY_PROFILE=edge

# --- PostgreSQL (edge compose)
POSTGRES_DB=threadeye
POSTGRES_USER=threadeye
POSTGRES_PASSWORD=change-me-local-db
# docker-compose.yml builds THREADEYE_DATABASE_URL from the three values above.
# For running the API on the host (uv run uvicorn ...), set it yourself, e.g.:
# THREADEYE_DATABASE_URL=postgresql+psycopg://threadeye:change-me-local-db@localhost:5432/threadeye

# --- Sessions / cookies
THREADEYE_SESSION_TTL_HOURS=12
# true behind HTTPS (cloud_demo), false for the local edge box on http://localhost
THREADEYE_COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API (same-origin via proxy needs none)
THREADEYE_ALLOWED_ORIGINS=http://localhost:8080

# --- Detector provider (only "simulated" exists in this phase; api/local_model are stubs)
THREADEYE_DETECTOR_PROVIDER=simulated

# --- Storage (edge: local volume; cloud_demo: Supabase Storage, M6)
THREADEYE_STORAGE_DIR=/data/storage
THREADEYE_DATASETS_DIR=/data/datasets

# --- Demo users (local development / demo box only).
# When THREADEYE_SEED_DEMO_USERS=true the API creates one account per role on start-up:
# inspector, supervisor, store, cutting, merchandiser, management, admin
# all using this password. Change it for any shared or public deployment.
THREADEYE_SEED_DEMO_USERS=true
THREADEYE_DEMO_PASSWORD=threadeye-demo-2026

# --- Edge proxy port on the host
THREADEYE_HTTP_PORT=8080

# --- Local test database used by `make test` (throwaway container on port 55432)
TEST_DATABASE_URL=postgresql+psycopg://threadeye:threadeye@localhost:55432/threadeye_test
